# KisanSetu backend - local environment variables.
#
# IMPORTANT: Spring Boot does NOT load this file automatically. There is no
# dotenv dependency in pom.xml. For a local run, export these as real shell
# variables before `mvn spring-boot:run` (PowerShell: `$env:NAME = "value"`),
# or configure them as environment variables in your IDE's run configuration.
# For a deployed backend (Render), set these in the hosting platform's
# environment-variable panel instead - never in a committed file.
#
# Never commit a filled-in copy of this file. `backend/.env` is gitignored.

# --- Database (required, no default) ---------------------------------------
# Use the Supabase "Session pooler" connection string (port 5432), not the
# direct-connection host - the pooler is IPv4-compatible, which matters if
# this backend is later deployed to a host (e.g. Render) on an IPv4-only
# network. Convert Supabase's postgresql:// URI to a JDBC URL:
#   DB_URL      = jdbc:postgresql://<pooler-host>:5432/postgres
#   DB_USERNAME = postgres.<project-ref>   (pooler usernames include the ref)
#   DB_PASSWORD = <your database password>
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- CORS (optional, defaults to localhost:3000) ----------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Supabase project + auth (required, no default) -------------------------
# Supabase Dashboard -> Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Dashboard -> Settings -> API -> JWT Settings. Only consulted for
# legacy HS256-signed tokens; current Supabase projects sign with ES256 and
# verify via SUPABASE_JWT_JWK_URI instead, so this may be left blank.
SUPABASE_JWT_SECRET=
# https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_JWK_URI=

# --- AI / Groq (optional - empty means the offline fallback provider runs) --
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=1024

# --- Weather (optional - Open-Meteo needs no key) ---------------------------
WEATHER_PROVIDER=open-meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1
WEATHER_API_KEY=

# --- Storage (optional) ------------------------------------------------------
STORAGE_BUCKET=kisansetu
STORAGE_PUBLIC_BASE_URL=
STORAGE_BUCKET_URL=

# --- Logistics (optional) ----------------------------------------------------
LOGISTICS_EARNING_PERCENTAGE=5.0
DEFAULT_CITY=

# --- Maps (optional - OSM needs no key) -------------------------------------
MAP_PROVIDER=osm
MAP_API_KEY=

# --- Server (optional, defaults to 8080; Render injects its own PORT) ------
PORT=8080
